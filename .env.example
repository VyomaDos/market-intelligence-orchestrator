# Primary search provider (required for live research)
YDC_API_KEY=

# Analysis/synthesis model (required for live research)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Runtime controls
SEARCH_RESULTS_PER_QUERY=8
SEARCH_FRESHNESS=month
MAX_CONCURRENCY=3
REQUEST_TIMEOUT_SECONDS=30

# Pricing assumptions used for pre-run estimates and actual cost reporting.
# Update these if you change providers, models, or service tier.
YDC_COST_PER_1000_CALLS=5.00
LLM_INPUT_COST_PER_MILLION=0.40
LLM_CACHED_INPUT_COST_PER_MILLION=0.10
LLM_OUTPUT_COST_PER_MILLION=1.60
